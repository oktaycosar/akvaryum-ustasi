; Open this file in Godot 4.7.2 or newer compatible Godot 4.x.
config_version=5

[application]
config/name="Akvaryum Ustası"
config/version="0.1.0"
run/main_scene="res://scenes/aquarium.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/size/min_width=960
window/size/min_height=600
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.065, 0.09, 1)

[audio]
driver/enable_input=false
